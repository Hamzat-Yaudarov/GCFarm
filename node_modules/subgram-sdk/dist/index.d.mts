type CheckoutPageResponse = {
    subscription_uuid: string;
    checkout_url: string;
};
type SubscriptionStatusResponse = {
    subscription_uuid: string;
    status: string;
    started_at: string | null;
    ending_at: string | null;
    cancelled_at: string | null;
    user_has_access: boolean;
    can_be_purchased: boolean;
    can_be_cancelled: boolean;
    can_be_upgraded: boolean;
};
type CustomerEventObject = {
    telegram_id: number;
    name: string | null;
    email: string | null;
    language_code: string | null;
};
type SubscriptionEventObject = {
    status: SubscriptionStatusResponse;
    customer: CustomerEventObject;
};
declare enum EventType {
    SUBSCRIPTION_STARTED = "subscription.started",
    SUBSCRIPTION_RENEWED = "subscription.renewed",
    SUBSCRIPTION_RENEW_FAILED = "subscription.renew_failed",
    SUBSCRIPTION_CANCELLED = "subscription.cancelled",
    SUBSCRIPTION_UPGRADED = "subscription.upgraded"
}
type Event = {
    event_id: number;
    type: EventType;
    object: SubscriptionEventObject;
};

declare class Subgram {
    private BASE_URL;
    private apiToken;
    constructor(token: string);
    private get client();
    hasAccess(userId: number, productId: number): Promise<boolean>;
    createCheckoutPage(productId: number, userId: number, name: string, languageCode?: string): Promise<CheckoutPageResponse>;
    listenToEvents(timeout?: number): AsyncGenerator<Event, void, undefined>;
}

export { Subgram as default };
